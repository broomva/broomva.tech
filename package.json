{
  "name": "@broomva/tech",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:dependencies": "bun scripts/audit-dependencies.ts",
    "test:audit-policy": "bun test scripts/audit-dependencies.test.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "vercel-build": "turbo run vercel-build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "typecheck": "turbo run typecheck",
    "check:links": "turbo run check:links",
    "check:content": "turbo run check:content",
    "check:prerender-cache": "turbo run check:prerender-cache",
    "check:public-asset-routes": "turbo run check:public-asset-routes",
    "sync:assets": "bun scripts/sync-assets-to-lago.ts"
