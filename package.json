    "fastify": "5.11.3",
    "find-my-way": "9.7.0",
    "form-data": "4.0.6",
    "hono": "4.13.1",
    "ip-address": "10.4.0",
    "kysely": "0.28.17",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "path-to-regexp": "8.4.2",
    "postcss": "8.5.26",
    "qs": "6.15.3",
    "mermaid": "11.16.1",
    "ua-parser-js": "2.0.10",
    "uuid": "11.1.1",
    "vite": "8.2.1",
    "ws": "8.21.3"
  }
